<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Kerberos.NET" Version="4.6.168" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Explicit Relational pin matching the EF Core version the rest of the solution uses.
         Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 declares a minimum of EF Core 10.0.4, so a
         project that names only the provider resolves Relational 10.0.4 and MSBuild reports an
         unresolvable MSB3277 conflict against the 10.0.12 the API pulls in. Same reason the
         previous provider needed this pin, different numbers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="NCrontab.Signed" Version="3.4.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.12" />
    <!-- Kerberos.NET and MimeKit bring 10.0.0, which has GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <ProjectReference Include="..\ModularCA.Database\ModularCA.Database.csproj" />
    <ProjectReference Include="..\ModularCA.Keystore\ModularCA.Keystore.csproj" />
	<ProjectReference Include="..\ModularCA.Shared\ModularCA.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surface internal helpers (DnEquals, ResolveJobTimeout, ComputeAnchorForFirstRun, …)
         to the unit-test project so tests can verify them without going through the full
         public API. Production callers see no behavior change. -->
    <InternalsVisibleTo Include="ModularCA.Tests" />
  </ItemGroup>

</Project>

