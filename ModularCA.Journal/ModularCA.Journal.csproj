<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The signer's issuance journal: the record format, the payload encoding, the writer, the
      verifier and the reader behind the head command. It references no database, no ASP.NET and
      no other ModularCA project, so a verifier or the head command can use it alone on a bare
      copy of a journal directory. docs/architecture/signer-journal.md states the format.

      System.Formats.Cbor is the package ModularCA.Bootstrap already pins (10.0.15), for the
      payloads' deterministic CBOR. BouncyCastle is the solution's own version, for verifying a
      checkpoint or key block signature under whichever algorithm the instance's keys use.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModularCA.Tests" />
  </ItemGroup>

</Project>
