<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
	<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.0" />
	<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.14" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.14" />
	<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.5" />
	<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
	<PackageReference Include="NCrontab.Signed" Version="3.4.0" />
	<PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
	<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	<PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
	<PackageReference Include="Serilog.Sinks.Network" Version="3.0.0" />
	<PackageReference Include="Serilog.Sinks.SyslogMessages" Version="4.1.0" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
	<ProjectReference Include="..\ModularCA.Auth\ModularCA.Auth.csproj" />
	<ProjectReference Include="..\ModularCA.Bootstrap\ModularCA.Bootstrap.csproj" />
	<ProjectReference Include="..\ModularCA.Database\ModularCA.Database.csproj" />
	<ProjectReference Include="..\ModularCA.Core\ModularCA.Core.csproj" />
	<ProjectReference Include="..\ModularCA.Keystore\ModularCA.Keystore.csproj" />

  </ItemGroup>

  <!-- The five SPA directories under wwwroot are build output, not project content, and they must
       not be part of the SDK's default Content glob.

       That glob is evaluated when the project is loaded — before any target runs — so it captured
       whatever the PREVIOUS build left in wwwroot. StaticWebAssets then built its asset manifest
       from those stale, content-hashed filenames, and the publish-time Brotli step went looking
       for files the current build had already replaced. It also meant a delete could never be
       added safely: clearing the directory mid-build left the manifest pointing at nothing.

       Removing them here means wwwroot is no longer the route by which the UI reaches a publish.
       CopyWebUIs still populates it for `dotnet run`, and PublishWebUIs contributes the bundles to
       the publish output directly from the Vite dist folders, which are always current.

       Root-level wwwroot content (index.html, assets/, vite.svg) stays in the glob — it is not
       generated by this pipeline. -->
  <ItemGroup>
    <Content Remove="wwwroot/admin/**" />
    <Content Remove="wwwroot/user/**" />
    <Content Remove="wwwroot/public/**" />
    <Content Remove="wwwroot/docs/**" />
    <Content Remove="wwwroot/setup/**" />
  </ItemGroup>

  <!-- Staging builds carry sourcemaps; Release does not.

       The five vite.config.ts files read MODULARCA_SOURCEMAP, so the decision is visible where a
       reader looks for it rather than buried in a CLI flag here. Set only for Staging: the cost
       is artifact size, and the benefit is that a production-style build on a staging box
       produces stacks that name a file and a line instead of a minified chunk offset. -->
  <PropertyGroup>
    <ViteSourcemapEnv Condition="'$(Configuration)' == 'Staging'">MODULARCA_SOURCEMAP=1</ViteSourcemapEnv>
  </PropertyGroup>

  <!-- Build web UIs in Staging/Release configurations -->
  <Target Name="BuildWebUIs" BeforeTargets="Build" Condition="'$(Configuration)' == 'Staging' OR '$(Configuration)' == 'Release'">
    <!-- Keep every UI's package.json "version" in sync with the canonical repo-root VERSION file
         (the same file Directory.Build.props reads for the assemblies), so npm metadata can't drift. -->
    <Message Text="Syncing UI package.json versions from VERSION..." Importance="high" />
    <Exec Command="node scripts/sync-package-versions.mjs" WorkingDirectory="$(ProjectDir).." />

    <!-- Regenerate shared/common/src/generated/ from the C# DTOs, enums, StepUpOps and usage
         vocabulary. Must run BEFORE any SPA typechecks, so a backend contract change surfaces as
         a TypeScript error in this same build rather than as a runtime 400 later. Write mode
         rather than check mode, so the build is self-healing; stale checked-in output then shows
         up as a git diff instead of a failed build. -->
    <Message Text="Generating shared TypeScript from C# contracts..." Importance="high" />
    <Exec Command="node scripts/generate-shared-types.mjs" WorkingDirectory="$(ProjectDir).." />

    <!-- Admin UI. One bundle serves both /admin (management console) and /user (self-service
         portal); the server hands its index.html to either prefix. -->
    <Message Text="Building Admin UI..." Importance="high" />
    <Exec Command="npm install --legacy-peer-deps" WorkingDirectory="$(ProjectDir)../modularca.adminui" />
    <Exec Command="node_modules/.bin/tsc -b --force" WorkingDirectory="$(ProjectDir)../modularca.adminui" />
    <Exec EnvironmentVariables="$(ViteSourcemapEnv)" Command="node_modules/.bin/vite build" WorkingDirectory="$(ProjectDir)../modularca.adminui" />

    <!-- Public UI -->
    <Message Text="Building Public UI..." Importance="high" />
    <Exec Command="npm install --legacy-peer-deps" WorkingDirectory="$(ProjectDir)../modularca.publicui" />
    <Exec Command="node_modules/.bin/tsc -b --force" WorkingDirectory="$(ProjectDir)../modularca.publicui" />
    <Exec EnvironmentVariables="$(ViteSourcemapEnv)" Command="node_modules/.bin/vite build" WorkingDirectory="$(ProjectDir)../modularca.publicui" />

    <!-- Setup UI -->
    <Message Text="Building Setup UI..." Importance="high" />
    <Exec Command="npm install --legacy-peer-deps" WorkingDirectory="$(ProjectDir)../modularca.setupui" />
    <Exec Command="node_modules/.bin/tsc -b --force" WorkingDirectory="$(ProjectDir)../modularca.setupui" />
    <Exec EnvironmentVariables="$(ViteSourcemapEnv)" Command="node_modules/.bin/vite build" WorkingDirectory="$(ProjectDir)../modularca.setupui" />

    <!-- Docs UI -->
    <Message Text="Building Docs UI..." Importance="high" />
    <Exec Command="npm install --legacy-peer-deps" WorkingDirectory="$(ProjectDir)../modularca.docsui" />
    <Exec Command="node_modules/.bin/tsc -b --force" WorkingDirectory="$(ProjectDir)../modularca.docsui" />
    <Exec EnvironmentVariables="$(ViteSourcemapEnv)" Command="node_modules/.bin/vite build" WorkingDirectory="$(ProjectDir)../modularca.docsui" />
  </Target>

  <!-- Copy built web UIs to both source wwwroot and output directory -->
  <Target Name="CopyWebUIs" AfterTargets="Build" Condition="'$(Configuration)' == 'Staging' OR '$(Configuration)' == 'Release'">
    <ItemGroup>
      <AdminUIFiles Include="../modularca.adminui/dist/**/*" />
      <PublicUIFiles Include="../modularca.publicui/dist/**/*" />
      <SetupUIFiles Include="../modularca.setupui/dist/**/*" />
      <DocsUIFiles Include="../modularca.docsui/dist/**/*" />
    </ItemGroup>
    <!-- Safe to clear now: these directories are excluded from the Content glob above, so no
         asset manifest refers to what is being deleted. Vite emits a new content-hashed filename
         on every build, so without this the directory only ever grows — it had reached 6,880
         files and 199 MB against 112 for one real build, all of it published and none reachable. -->
    <!-- wwwroot/user stays in the list although nothing writes it any more: a checkout that
         built before the user portal merged into the admin bundle still has one. -->
    <RemoveDir Directories="$(ProjectDir)wwwroot/admin;$(ProjectDir)wwwroot/user;$(ProjectDir)wwwroot/public;$(ProjectDir)wwwroot/docs;$(ProjectDir)wwwroot/setup" />
    <RemoveDir Directories="$(OutputPath)wwwroot/admin;$(OutputPath)wwwroot/user;$(OutputPath)wwwroot/public;$(OutputPath)wwwroot/docs;$(OutputPath)wwwroot/setup" />

    <!-- Copy to source wwwroot, which is what `dotnet run` serves from: the content root is the
         project directory, not the output directory. -->
    <Copy SourceFiles="@(AdminUIFiles)" DestinationFolder="$(ProjectDir)wwwroot/admin/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublicUIFiles)" DestinationFolder="$(ProjectDir)wwwroot/public/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SetupUIFiles)" DestinationFolder="$(ProjectDir)wwwroot/setup/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DocsUIFiles)" DestinationFolder="$(ProjectDir)wwwroot/docs/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- Copy to output directory (ensures current build has the files) -->
    <Copy SourceFiles="@(AdminUIFiles)" DestinationFolder="$(OutputPath)wwwroot/admin/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublicUIFiles)" DestinationFolder="$(OutputPath)wwwroot/public/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SetupUIFiles)" DestinationFolder="$(OutputPath)wwwroot/setup/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DocsUIFiles)" DestinationFolder="$(OutputPath)wwwroot/docs/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Web UIs copied to wwwroot and output directory" Importance="high" />
  </Target>

  <!-- Publish the SPA bundles straight from the Vite dist folders.

       Runs before the publish file list is computed and sources from dist/ rather than wwwroot/,
       so what ships is exactly what this build produced. This replaces the old reliance on the
       wwwroot glob, and it is why stale bundles can no longer reach an artifact: nothing that
       accumulates between builds is on the path to publish any more. -->
  <Target Name="PublishWebUIs" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Staging' OR '$(Configuration)' == 'Release'">
    <ItemGroup>
      <_AdminPublish Include="../modularca.adminui/dist/**/*" />
      <_PublicPublish Include="../modularca.publicui/dist/**/*" />
      <_SetupPublish Include="../modularca.setupui/dist/**/*" />
      <_DocsPublish Include="../modularca.docsui/dist/**/*" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_AdminPublish)">
        <RelativePath>wwwroot/admin/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_PublicPublish)">
        <RelativePath>wwwroot/public/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_SetupPublish)">
        <RelativePath>wwwroot/setup/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_DocsPublish)">
        <RelativePath>wwwroot/docs/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Text="Web UI bundles queued for publish from dist/" Importance="high" />
  </Target>

</Project>