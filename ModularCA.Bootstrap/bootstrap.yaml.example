# Unattended bootstrap configuration
# Only used by --bootstrap CLI mode. The setup wizard collects these values interactively.

CA:
  Subject:
    CN: "ModularCA Root CA"
    O: "ModularCA"
    OU: ["Infrastructure"]
    L: "Austin"
    ST: "Texas"
    C: "US"
  Algorithm: ECDSA
  KeySize: 384
  ValidityYears: 10

SigningProfile:
  Name: "default"
  IsCa: true
  KeyUsages:
    - digitalSignature
    - keyCertSign
    - crlSign
  ExtendedKeyUsages:
    - 1.3.6.1.5.5.7.3.1

Features:
  # CRL and OCSP stay on: a working PKI cannot function without revocation publishing.
  # The four enrollment protocols default to FALSE and must be opted into deliberately —
  # a first-run install should not expose anonymous enrollment because a shipped template
  # said so. Matches YamlBootstrapLoader.FeaturesConfig, which defaults them off, and the
  # setup wizard, which leaves them unticked.
  CRL: true
  OCSP: true
  ACME: false
  EST: false
  SCEP: false
  CMP: false
  MSAE: false

Administration:
  # Will more than one person administer this CA?
  #   true  - key ceremonies start ON: creating, revoking or deleting a CA needs another
  #           administrator's approval, and the person who starts a ceremony can never approve it.
  #   false - just one administrator: key ceremonies start OFF for the instance and for the first
  #           space, because nobody else could approve one, and a system super-administrator may
  #           approve their own certificate requests. Turn ceremonies on and self-approval off in
  #           the console (Settings, and the space's page) once a second administrator exists.
  # Leave the key out and key ceremonies start on.
  MultipleAdministrators: true

  # How the first administrator, superadmin, gets in. Nothing secret is printed either way.
  #   Without a claim token (the default): the bootstrap generates a password and leaves it in
  #     config/initial-admin-password, readable by the service account only. Read it, sign in,
  #     and change the password when asked; the file is deleted when you do.
  #   With a claim token: superadmin is created with no password, and whoever holds the token
  #     sets one at the console's sign-in page, under "Have a claim token?" (/claim). This file
  #     carries only the token's SHA-256 (lowercase hex), never the token. To make a pair:
  #       ModularCA.API --new-claim-token
  #     or hash 32 random bytes in base64url yourself: printf %s "$token" | sha256sum
  #     The claim works once, and expires after ClaimTokenLifetimeHours (168, seven days, when
  #     left out; at most 8760). After that, issue a new one on the host:
  #       ModularCA.API --issue-claim-token superadmin
  # ClaimTokenSha256: "<64 hex digits>"
  # ClaimTokenLifetimeHours: 168

Acme:
  # Will ACME clients be on a private network? Only read when Features.ACME is true.
  #   true  - the first CA's http-01 validation may fetch challenges from private, loopback and
  #           link-local addresses, and resolves names through this host's hosts file as well as
  #           DNS. An internal CA needs this, or every http-01 request for a private address is
  #           refused.
  #   false - those addresses are refused. Keep this for a CA that validates public names: with
  #           it on, whoever can request a certificate can make this server fetch from addresses
  #           inside your network.
  # Leave the key out and it is false. Change it later per CA in the console, under the CA's
  # protocol settings.
  AllowPrivateAddressValidation: false

HttpsApi:
  CN: "ModularCA API"
  # The bare hostname or IP address clients reach this instance by: no scheme, port or path.
  # ACME directory URLs, redirects, passkey sign-in and the CRL, OCSP and AIA URLs in issued
  # certificates are built from it, and the node will not start without one. Leave the key out
  # and it is the first DNS name under SANs that is not localhost, or localhost when there is
  # none. A name the SANs do not cover is added to the certificate.
  # PublicDomain: "ca.example.com"
  SANs:
    - "DNS:localhost"
    - "IP:127.0.0.1"
    - "IP:::1"
  Port: 8443
  ValidityDays: 397
