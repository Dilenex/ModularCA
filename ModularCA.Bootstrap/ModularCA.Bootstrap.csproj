<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ModularCA.Bootstrap</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModularCA.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Explicit Relational pin matching the EF Core version the rest of the solution uses.
         Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 declares a minimum of EF Core 10.0.4, so a
         project that names only the provider resolves Relational 10.0.4 and MSBuild reports an
         unresolvable MSB3277 conflict against the 10.0.12 the API pulls in. Same reason the
         previous provider needed this pin, different numbers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="NCrontab.Signed" Version="3.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Fido2 4.0.1 (through ModularCA.Auth) asks for System.Formats.Cbor 9.0.0, which is affected by
         GHSA-vmv3-wvjp-wqpj. The API and the tests take the library from the ASP.NET Core shared
         framework, which is why only this project resolved the package. Lifted to the patched
         version here; drop the pin when Fido2 asks for a patched one itself. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    <ProjectReference Include="..\ModularCA.Auth\ModularCA.Auth.csproj" />
	<ProjectReference Include="..\ModularCA.Keystore\ModularCA.Keystore.csproj" />
	<ProjectReference Include="..\ModularCA.Shared\ModularCA.Shared.csproj" />
	  <ProjectReference Include="..\ModularCA.Core\ModularCA.Core.csproj" />
  </ItemGroup>

</Project>

