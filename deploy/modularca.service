# ModularCA — systemd unit stub
#
# Install:
#   sudo ./install.sh     (from the extracted archive; it creates the account), or install the .deb
#   sudo systemctl enable --now modularca
#
# The program files in /opt/modularca belong to root; the service account owns only the runtime
# directories listed in ReadWritePaths below. install.sh and the .deb's postinst set this up.
#
# Logs:  journalctl -u modularca -f
#
# The published build is self-contained (linux-x64), so no .NET runtime is required
# on the host. ModularCA.API is the ELF entrypoint.

[Unit]
Description=ModularCA Certificate Authority
Documentation=https://github.com/edphemeral/modularCA
# The CA cannot serve issuance, OCSP or CRL without its database. Ordering only —
# add Requires= if the DB is local and the service should not start without it.
After=network-online.target postgresql.service
Wants=network-online.target

# These belong in [Unit], not [Service]: they moved in systemd 229 and a modern systemd ignores
# them under [Service] with an "Unknown key name" warning. That was survivable while Restart was
# on-failure; with Restart=always it is not, because an app that fails at startup would retry
# every 5s forever. Five attempts in 300s, then systemd gives up and leaves the unit failed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# notify, not simple: the app calls builder.Host.UseSystemd() (StartModularCA.cs),
# so it signals READY=1 only once Kestrel is actually listening. With Type=simple,
# systemd would report the unit active while bootstrap was still running and any
# dependent unit would start too early.
Type=notify
NotifyAccess=main

User=modularca
Group=modularca
WorkingDirectory=/opt/modularca
ExecStart=/opt/modularca/ModularCA.API

# Config, keystores, logs and backups resolve relative to AppContext.BaseDirectory, i.e. the
# install directory. See ReadWritePaths below.
Environment=DOTNET_ENVIRONMENT=Production
# Serilog writes structured JSON to stdout when running under systemd; journald captures it.
Environment=DOTNET_CONSOLE_ANSI_COLOR=false

# always, not on-failure: the setup wizard finishes by calling StopApplication() so the
# process comes back up outside setup mode, and that is a CLEAN exit. Under on-failure systemd
# read status 0 as "job done" and left the CA stopped — while the server logged "Application
# will restart into production mode" and the wizard told the operator the same thing. Both
# promised a restart the unit would not perform.
#
# The thrash protection that on-failure was chosen for is provided by the start limit below,
# which applies to every restart cause: bootstrap still exits non-zero on a fatal
# misconfiguration (bad JWT secret, mTLS enabled with no trust anchors), and systemd still gives
# up after 5 attempts in 300s rather than filling the journal with the same failure.
#
# A `systemctl stop` is unaffected — that is a stop job, not a service exit, and always does not
# override it.
Restart=always
RestartSec=5s
# Exit status 3 is the startup schema check refusing: something only an operator can fix (a schema
# newer than this build, a wrong password or pg_hba rule, tables the runtime role does not own, a
# migration that failed for good). A restart cannot fix it, so the unit stops as failed at once
# instead of using up its start limit. Transient conditions are waited for or retried inside the
# process, not by restarts: an unreachable database, a migration in progress, and a migration that
# failed on a lock timeout, a deadlock or a lost connection. Status 75 means that went on for
# longer than Schema.WaitSeconds (900 s); systemd retries it, and each such restart takes at least
# that long, so the start limit below is not reached by a database that is merely slow to come back.
RestartPreventExitStatus=3

# CRL/OCSP/AIA must be reachable over plain HTTP per RFC 5280, and operators commonly
# move Http.Port/Https.Port to 80/443. Defaults are 8080/8443, which need no capability
# — drop this line if you keep the unprivileged defaults.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- Hardening -------------------------------------------------------------------
# This process holds CA private key material. Defaults here are deliberately strict;
# loosen only with a reason.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes the whole filesystem read-only, so every path the app writes must be
# listed: the runtime directories, the list RUNTIME_DIRS keeps in install.sh and postinst. The
# program files around them stay read-only. A Backup.OutputPath, AuditRetention.ArchivePath,
# SshCa.KeyStoragePath or Logging.FilePath configured outside these needs its own entry in a
# drop-in, and must be owned by this user.
ReadWritePaths=/opt/modularca/config /opt/modularca/keystores /opt/modularca/logs /opt/modularca/backups

# Core dumps of this process would contain unwrapped key material.
LimitCORE=0

LimitNOFILE=65535
# The schema check runs before READY=1. Throughout it (reading, waiting, retrying, migrating) a
# heartbeat extends this every 20 s with EXTEND_TIMEOUT_USEC (systemd 236 or later), so it bounds
# a start that hangs elsewhere, not the check. The check's own connect and command timeouts,
# Schema.WaitSeconds and Schema.MigrationCommandTimeoutSeconds in config.yaml bound that.
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
