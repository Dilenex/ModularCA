# ModularCA — systemd unit stub
#
# Install:
#   sudo useradd --system --home /opt/modularca --shell /usr/sbin/nologin modularca
#   sudo mkdir -p /opt/modularca && sudo cp -r dist/linux-x64/* /opt/modularca/
#   sudo chown -R modularca:modularca /opt/modularca
#   sudo cp deploy/modularca.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now modularca
#
# Logs:  journalctl -u modularca -f
#
# The published build is self-contained (linux-x64), so no .NET runtime is required
# on the host. ModularCA.API is the ELF entrypoint.

[Unit]
Description=ModularCA Certificate Authority
Documentation=https://github.com/edphemeral/modularCA
# The CA cannot serve issuance, OCSP or CRL without its database. Ordering only —
# add Requires= if the DB is local and the service should not start without it.
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

# These belong in [Unit], not [Service]: they moved in systemd 229 and a modern systemd ignores
# them under [Service] with an "Unknown key name" warning. That was survivable while Restart was
# on-failure; with Restart=always it is not, because an app that fails at startup would retry
# every 5s forever. Five attempts in 300s, then systemd gives up and leaves the unit failed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# notify, not simple: the app calls builder.Host.UseSystemd() (StartModularCA.cs),
# so it signals READY=1 only once Kestrel is actually listening. With Type=simple,
# systemd would report the unit active while bootstrap was still running and any
# dependent unit would start too early.
Type=notify
NotifyAccess=main

User=modularca
Group=modularca
WorkingDirectory=/opt/modularca
ExecStart=/opt/modularca/ModularCA.API

# Config, keystores and backups resolve relative to AppContext.BaseDirectory, i.e. the
# install directory — so it must stay writable by this user. See ReadWritePaths below.
Environment=DOTNET_ENVIRONMENT=Production
# Serilog writes structured JSON to stdout when running under systemd; journald captures it.
Environment=DOTNET_CONSOLE_ANSI_COLOR=false

# always, not on-failure: the setup wizard finishes by calling StopApplication() so the
# process comes back up outside setup mode, and that is a CLEAN exit. Under on-failure systemd
# read status 0 as "job done" and left the CA stopped — while the server logged "Application
# will restart into production mode" and the wizard told the operator the same thing. Both
# promised a restart the unit would not perform.
#
# The thrash protection that on-failure was chosen for is provided by the start limit below,
# which applies to every restart cause: bootstrap still exits non-zero on a fatal
# misconfiguration (bad JWT secret, mTLS enabled with no trust anchors), and systemd still gives
# up after 5 attempts in 300s rather than filling the journal with the same failure.
#
# A `systemctl stop` is unaffected — that is a stop job, not a service exit, and always does not
# override it.
Restart=always
RestartSec=5s

# CRL/OCSP/AIA must be reachable over plain HTTP per RFC 5280, and operators commonly
# move Http.Port/Https.Port to 80/443. Defaults are 8080/8443, which need no capability
# — drop this line if you keep the unprivileged defaults.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- Hardening -------------------------------------------------------------------
# This process holds CA private key material. Defaults here are deliberately strict;
# loosen only with a reason.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes the whole filesystem read-only, so every path the app
# writes must be listed. Keystores, config and backups all live under the install dir.
ReadWritePaths=/opt/modularca

# Core dumps of this process would contain unwrapped key material.
LimitCORE=0

LimitNOFILE=65535
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
