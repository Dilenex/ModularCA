# Copy to .env beside compose.yaml and fill in.

# The PostgreSQL superuser's password. The setup wizard asks for it once, to create the two
# databases and their roles; ModularCA does not keep it. Set it before the first
# "docker compose up": PostgreSQL reads it only when its volume is empty.
POSTGRES_PASSWORD=

# The image to run. Unset, it is the newest stable release (the "latest" tag). A release
# candidate is never "latest", so name it:
MODULARCA_IMAGE=ghcr.io/dilenex/modularca:0.4.0-rc.1
