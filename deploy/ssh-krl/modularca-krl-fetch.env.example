# Settings of modularca-krl-fetch.service. Install as /etc/default/modularca-krl-fetch.
# systemd reads this file: one NAME=value to a line, no quotes needed, nothing is expanded.

# The KRL URL of the SSH CA key, as the key's page in the ModularCA console shows it. Must be https.
MODULARCA_KRL_URL=https://ca.example.com/ssh/ca-keys/00000000-0000-0000-0000-000000000000/krl

# Where the list is installed: the file RevokedKeys names in sshd_config. A directory other than
# /etc/ssh also needs ReadWritePaths= in a drop-in of the unit.
#MODULARCA_KRL_DEST=/etc/ssh/revoked_keys.krl

# A PEM bundle to verify the CA's web certificate with, when the system's trust store does not
# hold its issuer.
#MODULARCA_KRL_CACERT=/etc/ssl/certs/modularca-web-ca.pem

# Set to 1 for one run after the CA's database was restored from a backup: the restored list can
# have a lower version than the installed one, which is otherwise refused as an older list.
# Remove it again afterwards.
#MODULARCA_KRL_ALLOW_LOWER_VERSION=1
