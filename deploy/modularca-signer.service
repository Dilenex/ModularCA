# ModularCA — the signer as its own systemd unit
#
# The second unit of the hardened single-server shape: this process holds the keystore, the
# keystore passwords and the PKCS#11 session, and answers the node over gRPC with mutual TLS on
# loopback. It hosts no controller, console, scheduler or enrollment protocol. The node runs
# modularca.service with --role node and Signer.Mode: Remote, and holds no key.
#
# install.sh installs this unit as /etc/systemd/system/modularca-signer.service and the .deb as
# /lib/systemd/system/modularca-signer.service; neither enables it. Set up the split as
# README-DEPLOY.md, "Two units: the signer apart from the node", describes (after the node is set
# up as a single process and its wizard has completed): the signer's account, the ownership of
# keystores/ and config/, the identity, then
#   sudo systemctl enable --now modularca-signer
# Upgrades leave the ownership the split set alone. The binaries this unit runs belong to root.
#
# Logs:  journalctl -u modularca-signer -f

[Unit]
Description=ModularCA Signer (keystore and signing service)
Documentation=https://github.com/edphemeral/modularCA
# The signer classifies keys, verifies ceremonies and writes its audit through the database.
# After the node, not before it: the node's control role applies migrations before it reports
# ready, and the signer waits for them in-process (Schema.WaitSeconds). Ordered first, a waiting
# signer held up the node's start job while the node was what it waited for. The node refuses
# enrollment while the signer is unreachable and reconnects on its own, so it needs nothing from
# the signer to start. This is ordering only.
After=network-online.target postgresql.service modularca.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# notify: builder.Host.UseSystemd() signals READY=1 once the listener is up.
Type=notify
NotifyAccess=main

User=modularca-signer
Group=modularca-signer
WorkingDirectory=/opt/modularca
ExecStart=/opt/modularca/ModularCA.API --role signer

Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_CONSOLE_ANSI_COLOR=false

Restart=always
RestartSec=5s
# Exit status 3: the startup schema check refused, which only an operator can fix; not retried.
# Status 75: it waited Schema.WaitSeconds for the database or the node's migrations; retried.
RestartPreventExitStatus=3

# The signer listens on loopback 8446 by default (Signer.Listen); no privileged port.
CapabilityBoundingSet=

# --- Hardening -------------------------------------------------------------------
# This is the process that holds the CA private keys. Everything the node's unit locks down
# is locked down here, and the writable surface is smaller still: the keystores (a committed
# key appends to them) and the logs, nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only what the signer writes. config/ is read-only here: the identity commands run as this
# user before the unit starts, and the unit itself changes no configuration. logs/ belongs to the
# node's account, so on one host the signer's file logs are refused there and the journal has them.
ReadWritePaths=/opt/modularca/keystores /opt/modularca/logs
# A PKCS#11 module needs its device; add e.g. DeviceAllow= and drop PrivateDevices when using one.

# Core dumps of this process would contain unwrapped key material.
LimitCORE=0

LimitNOFILE=8192
# While the schema check waits it extends this with EXTEND_TIMEOUT_USEC (systemd 236 or later), so
# this bounds a start that hangs; Schema.WaitSeconds bounds the wait.
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
