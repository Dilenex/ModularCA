<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the produced binary's name stable for operators and for the deploy docs, which
         refer to it as ModularCA.Keystore rather than ModularCA.KeystoreCli. -->
    <AssemblyName>ModularCA.Keystore.Unlocker</AssemblyName>
    <RootNamespace>ModularCA.KeystoreCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularCA.Keystore\ModularCA.Keystore.csproj" />
  </ItemGroup>

</Project>
