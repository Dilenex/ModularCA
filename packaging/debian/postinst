#!/bin/sh
# ModularCA — post-installation.
#
# Creates the service account, seeds configuration only where none exists, and sets the ownership
# and modes the payload cannot carry itself. The build host is frequently Windows, where a file's
# mode means nothing, so every permission this install depends on is set here rather than inherited
# from the package — the same reasoning packaging/install.sh has always used.
#
# The one database step: on a local PostgreSQL, db-ownership.sh hands the tables a pre-0.4.0 wizard
# or CLI install left owned by the superuser to the runtime roles (see that script). It never fails
# this script. MODULARCA_SKIP_DB_REPAIR=1 turns it off.
set -e

APP_DIR=/opt/modularca
SERVICE_USER=modularca
SERVICE_GROUP=modularca
MARKERS=/run/modularca-upgrade
UNITS="modularca.service modularca-signer.service"
DB_OWNERSHIP=/usr/share/modularca/db-ownership.sh
# The directories under $APP_DIR the service writes at run time. Everything else there is program
# files, owned by root. packaging/install.sh keeps the same list, and ReadWritePaths= in
# modularca.service names the same directories.
RUNTIME_DIRS="config keystores logs backups"

runtime_mode() {
    case $1 in
        logs) echo 0750 ;;
        *) echo 0700 ;;
    esac
}

# Prints each path the package installed under $APP_DIR outside the runtime directories.
program_paths() {
    dpkg-query -L modularca 2>/dev/null | while IFS= read -r path; do
        case $path in
            "$APP_DIR"/*) ;;
            *) continue ;;
        esac
        top=${path#"$APP_DIR"/}
        top=${top%%/*}
        case " $RUNTIME_DIRS " in
            *" $top "*) continue ;;
        esac
        printf '%s\n' "$path"
    done
}

# Program files belong to root. dpkg writes every file root-owned with the package's mode, but
# leaves a directory that already exists as it is, and before 0.4.0 this script gave the whole
# tree to the service account. The signer runs these binaries too, so the node's account must not
# be able to replace them.
set_program_ownership() {
    chown root:root "$APP_DIR"
    chmod 0755 "$APP_DIR"
    program_paths | xargs -r -d '\n' chown -h root:root --
    program_paths | while IFS= read -r path; do
        if [ -d "$path" ] && [ ! -L "$path" ]; then
            chmod 0755 "$path"
        fi
    done
    for exe in ModularCA.API ModularCA.Keystore.Unlocker modularca-migrate; do
        if [ -e "$APP_DIR/$exe" ]; then
            chmod 0755 "$APP_DIR/$exe"
        fi
    done
}

# Creates each missing runtime directory for the service account, and hands over one that is
# still root's, as dpkg creates config/, keystores/ and logs/ on a first install. One that belongs
# to anyone else, or is a symlink, is left exactly as it is, contents included: on a split install
# the signer owns keystores/ and config/keystore.yaml, and the operator set config/'s group and mode.
prepare_runtime_dirs() {
    for dir in $RUNTIME_DIRS; do
        path=$APP_DIR/$dir
        [ -L "$path" ] && continue
        if [ ! -d "$path" ]; then
            install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m "$(runtime_mode "$dir")" "$path"
        elif [ "$(stat -c %U "$path")" = root ]; then
            chown "$SERVICE_USER:$SERVICE_GROUP" "$path"
            chmod "$(runtime_mode "$dir")" "$path"
        fi
    done
}

# The shipped .example files are the only configuration this package owns. A real config.yaml
# holds the database password and the JWT signing secret, so it is deliberately NOT a dpkg
# conffile: dpkg would keep hashes and backup copies of it in its own bookkeeping, and would
# prompt on upgrade to replace a working CA's identity with defaults. Seeding only where a
# file is absent gives the useful half of that behaviour with none of the hazard.
seed_config() {
    for example in "$APP_DIR"/config/*.example; do
        [ -e "$example" ] || continue
        target="${example%.example}"
        [ -e "$target" ] || install -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0600 "$example" "$target"
    done
}

set_ownership() {
    set_program_ownership
    prepare_runtime_dirs
    seed_config
}

# Starts, without waiting, the units prerm recorded as running: the node before the signer. The
# node applies migrations before it reports ready, which can take far longer than dpkg should wait.
start_recorded() {
    started=""
    for unit in $UNITS; do
        if [ -e "$MARKERS/restart-$unit" ]; then
            systemctl start --no-block "$unit" >/dev/null 2>&1 || true
            started="$started $unit"
        fi
    done
    rm -rf "$MARKERS"
    if [ -n "$started" ]; then
        echo "ModularCA: starting$started." >&2
    else
        echo "ModularCA: no unit was running before the upgrade; none was started." >&2
    fi
}

if [ "${MODULARCA_POSTINST_SOURCED:-}" = 1 ]; then
    return 0
fi

case "$1" in
configure)

    # ── Service account ────────────────────────────────────────────────────────
    if ! getent group "$SERVICE_GROUP" >/dev/null; then
        addgroup --system "$SERVICE_GROUP"
    fi
    if ! getent passwd "$SERVICE_USER" >/dev/null; then
        adduser --system --ingroup "$SERVICE_GROUP" --home "$APP_DIR" \
                --no-create-home --shell /usr/sbin/nologin \
                --gecos "ModularCA certificate authority" "$SERVICE_USER"
    fi

    # ── Ownership, modes and configuration ─────────────────────────────────────
    set_ownership

    # ── systemd ────────────────────────────────────────────────────────────────
    # A unit in /etc/systemd/system takes precedence over the one this package ships in /lib, and
    # silently. An install upgraded from the tarball will have exactly that file, left behind by
    # packaging/install.sh, and would keep running the old unit while every change to the packaged
    # one appeared to do nothing. Worth an explicit warning rather than a puzzle.
    for unit in $UNITS; do
        if [ -f "/etc/systemd/system/$unit" ]; then
            cat >&2 <<SHADOW

  WARNING: /etc/systemd/system/$unit exists and overrides the unit shipped by this
  package (/lib/systemd/system/$unit). It is most likely left over from a tarball
  install. Remove it, or move your changes into a drop-in:

      sudo rm /etc/systemd/system/$unit
      sudo mkdir -p /etc/systemd/system/$unit.d
      # put local overrides in /etc/systemd/system/$unit.d/override.conf
      sudo systemctl daemon-reload

SHADOW
        fi
    done

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true

        # An upgrade from a version whose prerm stopped only modularca.service and recorded
        # nothing: bring the node back if it is enabled, and restart a signer that was left
        # running so it runs the new binaries. Everything is stopped before the ownership step.
        # The old prerm runs before this package's preinst, so nothing can tell whether the node
        # was running; README-DEPLOY.md documents this one-time exception.
        if [ -n "$2" ] && [ ! -d "$MARKERS" ]; then
            mkdir -m 0700 "$MARKERS" 2>/dev/null || true
            if systemctl is-enabled --quiet modularca.service 2>/dev/null; then
                touch "$MARKERS/restart-modularca.service" 2>/dev/null || true
            fi
            if systemctl is-active --quiet modularca-signer.service 2>/dev/null; then
                touch "$MARKERS/restart-modularca-signer.service" 2>/dev/null || true
                systemctl stop modularca-signer.service >/dev/null 2>&1 || true
            fi
        fi
    fi

    # ── Schema ownership (pre-0.4.0 wizard and CLI installs) ───────────────────
    if [ "${MODULARCA_SKIP_DB_REPAIR:-0}" = "1" ]; then
        echo "ModularCA: MODULARCA_SKIP_DB_REPAIR=1 - schema ownership not checked by the package." >&2
    elif [ -f "$DB_OWNERSHIP" ]; then
        sh "$DB_OWNERSHIP" repair || true
    fi

    if [ -d /run/systemd/system ]; then
        if [ -z "$2" ]; then
            # First install. Enable so the CA comes back after a reboot, but do NOT start: there
            # is no database, no keystore and no configuration yet, so starting would fail-loop
            # into the journal and StartLimitBurst would then block the operator's own first
            # start attempt. The service comes up when the operator has bootstrapped it.
            systemctl enable modularca.service >/dev/null 2>&1 || true
            cat <<'FIRST'

  ModularCA installed to /opt/modularca (config: /etc/modularca, logs: /var/log/modularca).

  Next steps:
    1. Edit /etc/modularca/db.yaml and /etc/modularca/config.yaml
    2. sudo systemctl start modularca
    3. Complete setup at https://<host>:8443/setup/

  The service is enabled but not started - it has nothing to start with yet.

FIRST
        else
            # Upgrade. prerm stopped both units and recorded which were running; start exactly
            # those. An operator who had one stopped meant it, and an upgrade does not overrule that.
            start_recorded
            cat <<'UPGRADED'

  ModularCA upgraded. The service checks both databases and applies migrations itself when it
  starts, not this package, so a start can take a while. Follow it with:

      journalctl -u modularca -f

  A start the service refuses exits with status 3, prints the reason and the fix, and is not
  retried. A database that is unreachable or locked, or a migration that fails on a lock, a
  deadlock or a lost connection, is waited for and retried inside the service for up to
  Schema.WaitSeconds; only then does it exit with status 75, and systemd retries it.

UPGRADED
        fi
    fi
    ;;

abort-upgrade)
    # The upgrade failed after this version's prerm stopped the units: start them again.
    if [ -d /run/systemd/system ] && [ -d "$MARKERS" ]; then
        start_recorded
    fi
    ;;

abort-remove|abort-deconfigure)
    :
    ;;
esac

exit 0
