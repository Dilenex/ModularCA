<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A LIBRARY. It used to be OutputType=Exe so it could double as the standalone
      keystore-unlocker CLI, and that dual role cost more than it saved: as an Exe it emits its
      own apphost, deps.json and runtimeconfig.json, a referencing publish resolves it twice
      (once RID-less, once for the target RID), and `dotnet publish -r linux-x64` failed outright
      with NETSDK1152 duplicate-output errors. A UseAppHost condition had been added to suppress
      half of that; the config files were the half it could not reach.

      The CLI now lives in ModularCA.KeystoreCli, which references this project. One role each:
      this one is consumed by ModularCA.API, ModularCA.Core, ModularCA.Bootstrap and the tests;
      the CLI is published as its own executable alongside them.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Secure\SecureMemoryUtils.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="NCrontab.Signed" Version="3.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
	<ProjectReference Include="..\ModularCA.Database\ModularCA.Database.csproj" />
  </ItemGroup>

</Project>

