<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      No native apphost. This project is dual-role: a standalone keystore-unlocker CLI
      (KeystoreManager.cs -> Unlocker.Run) AND a library referenced by ModularCA.API,
      ModularCA.Core and ModularCA.Bootstrap. Being OutputType=Exe means it emits an apphost
      and its own deps.json/runtimeconfig.json, and a referencing publish resolves it twice —
      once RID-less and once for the target RID. That produced NETSDK1152 duplicate-output
      errors on `dotnet publish -r linux-x64`, and dropped a *Windows* ModularCA.Keystore.exe
      into the linux-x64 dist.

      Scoped to the RID-less build on purpose. An unconditional UseAppHost=false fails a
      self-contained publish outright (NETSDK1067: "Self-contained applications are required
      to use the application host"), because the RID-specific pass genuinely needs one. The
      condition suppresses only the host-platform apphost that nothing consumes, while the
      target-RID apphost — the usable ./ModularCA.Keystore launcher — is still produced.
    -->
    <UseAppHost Condition="'$(RuntimeIdentifier)' == ''">false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Secure\SecureMemoryUtils.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="NCrontab.Signed" Version="3.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
	<ProjectReference Include="..\ModularCA.Database\ModularCA.Database.csproj" />
  </ItemGroup>

</Project>

